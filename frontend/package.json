    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "beasties": "^0.5.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.0",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
