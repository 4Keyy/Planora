# Copy outside the checkout, mode 0600. Generate fresh independent random secrets.
PUBLIC_HOST=planora.example.com
PLANORA_SHARED_DIR=/opt/planora/shared
POSTGRES_PASSWORD=replace-with-random-secret
AUTH_DB_PASSWORD=replace-with-another-random-secret
CATEGORY_DB_PASSWORD=replace-with-another-random-secret
TODO_DB_PASSWORD=replace-with-another-random-secret
COLLABORATION_DB_PASSWORD=replace-with-another-random-secret
MESSAGING_DB_PASSWORD=replace-with-another-random-secret
REALTIME_DB_PASSWORD=replace-with-another-random-secret
REDIS_PASSWORD=replace-with-another-random-secret
RABBITMQ_USER=planora
RABBITMQ_PASSWORD=replace-with-another-random-secret
# For a restored broker, match the original hostname/node identity exactly.
RABBITMQ_HOSTNAME=planora-broker
JWT_SECRET=replace-with-at-least-32-random-characters
GRPC_SERVICE_KEY=replace-with-another-random-secret
Email__Provider=Smtp
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__EnableSsl=true
Email__Username=replace-with-mail-account
Email__Password=replace-with-mail-secret
Email__FromEmail=planora@example.com
Email__FromName=Planora
